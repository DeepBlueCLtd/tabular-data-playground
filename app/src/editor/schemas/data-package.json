{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specs.frictionlessdata.io/schemas/data-package.json",
  "title": "Data Package (placeholder)",
  "description": "Minimal placeholder bundled with the app. Runtime fetch from specs.frictionlessdata.io upgrades this when available.",
  "type": "object",
  "required": ["resources"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Short URL-safe slug identifying the package."
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "created": { "type": "string", "format": "date-time" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "image": { "type": "string" },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string", "format": "uri" },
          "title": { "type": "string" }
        }
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "path": { "type": "string", "format": "uri" },
          "role": {
            "type": "string",
            "enum": ["author", "publisher", "maintainer", "wrangler", "contributor"]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "path": { "type": "string", "format": "uri" },
          "email": { "type": "string", "format": "email" }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    }
  }
}
